{
  "manifest_version": 3,
  "name": "Torn Training Optimizer",
  "version": "1.0.0",
  "description": "Live gym recommendations inside torn.com plus anti-waste training alerts: energy overflow, happy jumped, drug cooldown clear.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.torn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Torn Training Optimizer"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/gym.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}